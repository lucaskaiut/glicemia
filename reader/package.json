{
  "name": "glicemia-leitor",
  "version": "1.1.0",
  "private": true,
  "description": "Lê o glicosímetro OK Meter Match II via USB e envia as medições para a API do Glicemia.",
  "main": "dist/main.js",
  "bin": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/okmeter.test.js",
    "package": "npm run build && pkg . --compress GZip"
  },
  "dependencies": {
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@yao-pkg/pkg": "6.23.0",
    "typescript": "5.7.2"
  },
  "pkg": {
    "targets": ["node24-win-x64"],
    "outputPath": "bin",
    "assets": ["node_modules/node-hid/prebuilds/HID-win32-x64/**/*"]
  }
}
